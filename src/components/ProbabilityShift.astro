---
/**
 * 문맥 A/B에 따라 다음 토큰 확률분포가 바뀌는 것을 보여 주는 스크립트 애니메이션.
 * 동일한 막대 차트가 두 문맥 값 사이를 오간다. prefers-reduced-motion이면
 * 문맥 B 상태로 정지 표시.
 */
const tokens = [
  { label: '좋다', a: 0.4, b: 0.1 },
  { label: '멋지다', a: 0.25, b: 0.08 },
  { label: '어렵다', a: 0.2, b: 0.12 },
  { label: '싫다', a: 0.15, b: 0.7 },
];
---

<prob-shift class="prob-shift" data-tokens={JSON.stringify(tokens)}>
  <div class="ps-frame">
    <p class="ps-sentence">이 표현은 아주 ___</p>
    <p class="ps-context" data-context>문맥 A: 예시 없음</p>
    <div class="ps-bars">
      {
        tokens.map((t) => (
          <div class="ps-row" data-a={t.a} data-b={t.b}>
            <span class="ps-label">{t.label}</span>
            <span class="ps-track">
              <span class="ps-bar" style={`width: ${t.a * 100}%`} />
            </span>
            <span class="ps-value">{t.a.toFixed(2)}</span>
          </div>
        ))
      }
    </div>
    <p class="ps-caption">같은 모델, 같은 질의 - 문맥만 다르다 (수치는 설명용 예시)</p>
  </div>
</prob-shift>

<script>
  class ProbShift extends HTMLElement {
    timer: ReturnType<typeof setInterval> | undefined;

    connectedCallback() {
      const rows = Array.from(this.querySelectorAll<HTMLElement>('.ps-row'));
      const ctx = this.querySelector<HTMLElement>('[data-context]');
      const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      let showB = false;

      const apply = (toB: boolean, instant: boolean) => {
        rows.forEach((row) => {
          const target = Number(row.dataset[toB ? 'b' : 'a']);
          const bar = row.querySelector<HTMLElement>('.ps-bar');
          const value = row.querySelector<HTMLElement>('.ps-value');
          if (!bar || !value) return;
          if (instant) bar.style.transition = 'none';
          bar.style.width = `${target * 100}%`;
          row.classList.toggle('ps-top', target >= 0.4);
          if (instant) {
            value.textContent = target.toFixed(2);
            requestAnimationFrame(() => (bar.style.transition = ''));
          } else {
            const from = Number(value.textContent);
            const start = performance.now();
            const dur = 900;
            const tick = (now: number) => {
              const k = Math.min((now - start) / dur, 1);
              value.textContent = (from + (target - from) * k).toFixed(2);
              if (k < 1) requestAnimationFrame(tick);
            };
            requestAnimationFrame(tick);
          }
        });
        if (ctx) ctx.textContent = toB ? '문맥 B: 방언 예시 2개 추가' : '문맥 A: 예시 없음';
        this.classList.toggle('ps-b', toB);
      };

      apply(reduced, true); // reduced-motion: 문맥 B 상태로 고정
      if (reduced) return;
      this.timer = setInterval(() => {
        showB = !showB;
        apply(showB, false);
      }, 2600);
    }

    disconnectedCallback() {
      if (this.timer) clearInterval(this.timer);
    }
  }
  customElements.define('prob-shift', ProbShift);
</script>

<style>
  .prob-shift {
    display: block;
    margin: 1rem 0;
  }
  .ps-frame {
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 10px;
    padding: 1rem 1.25rem;
    background: var(--sl-color-bg-nav);
  }
  .ps-sentence {
    margin: 0 0 0.25rem;
    font-weight: 600;
    text-align: center;
  }
  .ps-context {
    margin: 0 0 0.75rem;
    text-align: center;
    font-size: 0.9rem;
    color: var(--sl-color-accent-high);
    font-weight: 600;
    transition: color 0.4s;
  }
  .ps-row {
    display: grid;
    grid-template-columns: 3.5rem 1fr 3rem;
    align-items: center;
    gap: 0.5rem;
    margin: 0.35rem 0;
  }
  .ps-label {
    font-size: 0.9rem;
  }
  .ps-track {
    display: block;
    height: 1.1rem;
    background: var(--sl-color-gray-6);
    border-radius: 999px;
    overflow: hidden;
  }
  .ps-bar {
    display: block;
    height: 100%;
    border-radius: 999px;
    background: var(--sl-color-gray-3);
    transition: width 0.9s cubic-bezier(0.4, 0, 0.2, 1), background 0.4s;
  }
  .ps-top .ps-bar {
    background: var(--sl-color-accent);
  }
  .ps-top .ps-label,
  .ps-top .ps-value {
    font-weight: 700;
  }
  .ps-value {
    font-variant-numeric: tabular-nums;
    font-size: 0.85rem;
    text-align: right;
  }
  .ps-caption {
    margin: 0.75rem 0 0;
    font-size: 0.8rem;
    color: var(--sl-color-gray-3);
    text-align: center;
  }
</style>
